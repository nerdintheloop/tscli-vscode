{
  "name": "tscli-vscode",
  "version": "0.0.2",
  "description": "Syntax highlighting for tscli",
  "author": "Actual Person <human@nerdintheloop.com> (https://nerdintheloop.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerdintheloop/tscli-vscode.git"
  },
  "bugs": "https://github.com/nerdintheloop/tscli-vscode/issues",
  "homepage": "https://tscli.nerdintheloop.com",
  "publisher": "nerdintheloop",
  "displayName": "tscli",
  "icon": "./icon.png",
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "grammars": [
      {
        "injectTo": [
          "source.ts"
        ],
        "path": "./tscli.json",
        "scopeName": "inline.tscli"
      }
    ]
  },
  "keywords": [
    "bun",
    "cli",
    "deno",
    "syntax",
    "typescript",
    "utility"
  ],
  "type": "module",
  "engines": {
    "vscode": "^1.0.0"
  },
  "devDependencies": {
    "@nerdintheloop/tscli": "^0.0.4",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.2.0"
  }
}